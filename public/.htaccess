DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

# 1. Redirecciones 301 de URLs viejas del Blog a Productos (migración SEO)

RewriteRule ^blog/letras-acrilicas-3d-moda/?$ /productos/letras-acrilico/ [R=301,L]
RewriteRule ^blog/cafeterias-con-estilo/?$ /productos/menu-board/ [R=301,L]
RewriteRule ^blog/techos-led-para-gimnasios/?$ /productos/techos-led/ [R=301,L]
RewriteRule ^blog/neon-led-para-bares-modernos/?$ /productos/neon-led/ [R=301,L]
RewriteRule ^blog/pantallas-led-para-locales/?$ /productos/pantalla-led/ [R=301,L]
RewriteRule ^blog/led-pixel-para-discotecas/?$ /productos/pixel-led/ [R=301,L]

# 2. Servir archivos físicos directamente si existen

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Resolver peticiones RSC / Next.js prefetch (__PAGE__.txt)
RewriteCond %{REQUEST_URI} ^/(.*)/(__next\..*)\.__PAGE__\.txt$ [NC]
RewriteRule ^ /%1/%2/__PAGE__.txt [L]

RewriteCond %{REQUEST_URI} ^/(__next\..*)\.__PAGE__\.txt$ [NC]
RewriteRule ^ /%1/__PAGE__.txt [L]

# Solo devolver 204 si NO es archivo (!-f) Y TAMPOCO es carpeta (!-d) ni tiene index.html
RewriteCond %{QUERY_STRING} _rsc= [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
RewriteRule ^ - [R=204,L]

# 4. Fallback del blog dinámico con shell

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/plantilla1/(?!\_shell/?$).*$ /blog/plantilla1/\_shell/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/plantilla2/(?!\_shell/?$).*$ /blog/plantilla2/\_shell/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/plantilla3/(?!\_shell/?$).*$ /blog/plantilla3/\_shell/index.html [L]

# 5. Excluir extensiones estáticas y carpetas internas del trailing slash

RewriteCond %{REQUEST_URI} ^/\_next/ [OR]
RewriteCond %{REQUEST_URI} \.(txt|xml|json|js|css|html|png|jpg|jpeg|svg|webp|ico|woff|woff2|avif)$ [NC]
RewriteRule ^ - [L]

# 6. Forzar trailing slash a rutas limpias (Next.js trailingSlash: true)

RewriteCond %{REQUEST_URI} !(._)/$
RewriteRule ^(._)$ /$1/ [R=301,L]

# 7. Servir index.html de cada ruta estática

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]
</IfModule>
