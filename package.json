{
  "name": "neonledpublicidad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true, maxRetries: 5, retryDelay: 200 })\"",
    "prebuild": "npm run clean && node scripts/generate-sitemap.js && node scripts/generate-robots.js",
    "build": "env-cmd -f .env.production.local next build",
    "prebuild:staging": "npm run clean && env-cmd -f .env.staging.local node scripts/generate-sitemap.js && env-cmd -f .env.staging.local node scripts/generate-robots.js",
    "build:staging": "env-cmd -f .env.staging.local next build && node -e \"const fs = require('fs'); fs.rmSync('out-staging', { recursive: true, force: true }); fs.cpSync('out', 'out-staging', { recursive: true }); fs.rmSync('out', { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });\"",
    "build-prod": "set NODE_ENV=production && next build",
    "clean-build": "(if exist .next rmdir /s /q .next) && npm run build",
    "clean-build-prod": "(if exist .next rmdir /s /q .next) && npm run build-prod",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.12",
    "@cloudinary/react": "^1.14.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
